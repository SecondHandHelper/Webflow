    const params = getParamsObject();
    if (params.id || !brand.trim()) return;
    brandCheckTimer = setTimeout(async ()=>{
        const material = document.getElementById('itemMaterial')?.value?.trim() || '';
        const query = `brand=${encodeURIComponent(brand.trim())}&category=${encodeURIComponent(category || '')}&material=${encodeURIComponent(material)}`;
        let result;
        try {
            result = (await callBackendApi(`/api/brands/declineRules?${query}`))?.data;
        } catch (e) {
            console.error('Could not check the brand decline rules', e);
            return;
        }
        if (seq !== brandCheckSeq || !result?.decline) return;
        const wholeBrand = result.rule === 'always_reject';
        hardToSellText.textContent = wholeBrand ? `Vi s\xe4ljer tyv\xe4rr inte ${brand}-plagg p\xe5 grund av f\xf6r l\xe5g efterfr\xe5gan.` : `Vi s\xe4ljer tyv\xe4rr inte kategorin ${category} fr\xe5n ${brand} p\xe5 grund av f\xf6r l\xe5g efterfr\xe5gan.`;
        stopIcon.style.display = 'flex';
        warningIcon.style.display = 'none';
        hardToSellDiv.style.display = 'block';
        document.getElementById("itemBrand").setCustomValidity(wholeBrand ? `Vi s\xe4ljer inte plagg fr\xe5n ${brand}` : `Vi s\xe4ljer inte kategorin '${category}' fr\xe5n ${brand}`);
    }, 300);
}
